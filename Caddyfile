{
    email {$ACME_EMAIL:admin@facultydesk.local}
    local_certs
}

{$DOMAIN:localhost} {
    encode gzip zstd

    handle /api/* {
        uri strip_prefix /api
        reverse_proxy backend:8000
    }

    handle /healthz {
        reverse_proxy backend:8000
    }

    handle /readyz {
        reverse_proxy backend:8000
    }

    handle {
        reverse_proxy frontend:3000
    }
}
